# ==============================================================================
# ParkFlow Backend & Infrastructure Environment Variables (Root .env)
# Note: For frontend environment variables, see 'frontend/.env.example'.
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=parkflow
POSTGRES_PASSWORD=secret
POSTGRES_DB=parkflow
POSTGRES_URL=jdbc:postgresql://localhost:5432/parkflow

# Redis (Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ (Event Broker)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Security
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long
