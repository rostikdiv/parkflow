# ParkFlow Frontend Environment Variables

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8080

# Backend GraphQL WebSocket URL (for real-time spot updates)
VITE_WS_URL=ws://localhost:8080/graphql-ws

# CARTO Basemaps API Key (free from https://carto.com/basemaps/apikey)
VITE_CARTO_API_KEY=your_carto_api_key_here

# Note:
# - For local development (npm run dev), copy this file to 'frontend/.env' or 'frontend/.env.local'.
# - For production builds (npm run build / Vercel), 'frontend/.env.production' is used automatically.
